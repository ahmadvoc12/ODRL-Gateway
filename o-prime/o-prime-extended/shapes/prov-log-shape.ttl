@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix report: <https://w3id.org/force/compliance-report#> .
@prefix dpv:    <https://w3id.org/dpv#> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:     <https://example.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .


# ############################################################################
# SHACL SHAPES FOR PROV-O AUDIT LOG
# ############################################################################
# These shapes validate the PROV-O-based semantic audit logs generated by
# O-Prime, covering both health-record and university/student-record scenarios.
# They ensure that each access activity and its associated subgraphs
# (policy evaluation, violations, duties, data handling) conform to the
# expected structure for SPARQL queryability and compliance analysis.
#
# Coverage:
#   - Root access activity (prov:Activity with compliance report states)
#   - Personal data handling context (dpv:PersonalDataHandling)
#   - Accessed data fields (report:AccessedDataField)
#   - Policy evaluation records (report:PolicyEvaluation)
#   - Field-level count violations (report:FieldViolation)
#   - Constraint violations (report:ConstraintViolation)
#   - Access-level policy violations (report:PolicyViolation)
#   - Duty obligations (report:DutyObligation)
#
# Usage:
#   python3 evaluation/shacl-validate-real.py
#
# Dependencies:
#   - rdflib, pyshacl (Python packages)
#
# Note on Optional Fields:
#   Fields like report:decision, report:accessMethod, report:requestedAction,
#   report:accessedResource, and the trust-source metadata
#   (report:recipientTrust, report:purposeTrust, report:legalBasisTrust,
#   report:temporalTrust) are marked as OPTIONAL (sh:minCount 0) to
#   accommodate legacy audit logs that predate the extended gateway.
#   The core compliance states (activationState, attemptState,
#   performanceState, deonticState) remain REQUIRED for all logs.
# ############################################################################


# ============================================================================
# 1. ROOT ACCESS ACTIVITY SHAPE (RELAXED)
# ============================================================================
# Each monitored access is recorded as a prov:Activity with ODRL Compliance
# Report Model states (activationState, attemptState, performanceState,
# deonticState). Core compliance states are REQUIRED; enhanced metadata
# (decision, accessMethod, requestedAction, trust sources) are OPTIONAL
# to accommodate both legacy and extended audit logs.
# ============================================================================
ex:ProvLogEntryShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:name "PROV-O Access Activity Shape" ;
    sh:description "Validates completeness of O-Prime semantic audit log entries (root access activity)." ;

    # Required: timestamp
    sh:property [
        sh:path prov:startedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:name "startedAtTime" ;
        sh:message "Log entry must have a prov:startedAtTime timestamp."
    ] ;

    # Required: requesting agent (application)
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "wasAssociatedWith" ;
        sh:message "Log entry must identify the requesting agent via prov:wasAssociatedWith." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:class foaf:Agent ]
            [ sh:class odrl:Party ]
        )
    ] ;

    # Required: accessed resource
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:name "used" ;
        sh:message "Log entry must reference the accessed resource via prov:used." ;
        sh:nodeKind sh:IRI
    ] ;

    # Required: ODRL Compliance Report Model - activation state
    sh:property [
        sh:path report:activationState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( report:Active report:Inactive report:Suspended ) ;
        sh:name "activationState" ;
        sh:message "Log entry must have a valid report:activationState (Active, Inactive, or Suspended)."
    ] ;

    # Required: ODRL Compliance Report Model - attempt state
    sh:property [
        sh:path report:attemptState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( report:Attempted report:NotAttempted ) ;
        sh:name "attemptState" ;
        sh:message "Log entry must have a valid report:attemptState (Attempted or NotAttempted)."
    ] ;

    # Required: ODRL Compliance Report Model - performance state
    sh:property [
        sh:path report:performanceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( report:Performed report:NotPerformed ) ;
        sh:name "performanceState" ;
        sh:message "Log entry must have a valid report:performanceState (Performed or NotPerformed)."
    ] ;

    # Required: ODRL Compliance Report Model - deontic state
    sh:property [
        sh:path report:deonticState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( report:Fulfilled report:Violated report:NonSet ) ;
        sh:name "deonticState" ;
        sh:message "Log entry must have a valid report:deonticState (Fulfilled, Violated, or NonSet)."
    ] ;

    # ⚠️ OPTIONAL: gateway decision (ALLOWED or VIOLATION)
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:decision ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "ALLOWED" "VIOLATION" ) ;
        sh:name "decision" ;
        sh:message "If present, report:decision must be \"ALLOWED\" or \"VIOLATION\"."
    ] ;

    # ⚠️ OPTIONAL: HTTP method used for access
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:accessMethod ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "GET" "POST" "PUT" "PATCH" "DELETE" ) ;
        sh:name "accessMethod" ;
        sh:message "If present, report:accessMethod must be a valid HTTP method."
    ] ;

    # ⚠️ OPTIONAL: ODRL action requested (ex:read, ex:create, ex:update, ex:delete)
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:requestedAction ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "requestedAction" ;
        sh:message "If present, report:requestedAction must be a string."
    ] ;

    # ⚠️ OPTIONAL: accessed resource IRI (full path)
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:accessedResource ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "accessedResource" ;
        sh:message "If present, report:accessedResource must be an IRI."
    ] ;

    # ⚠️ OPTIONAL: trust source for recipient (jwt-verified, url-inferred, unknown)
    # Added in extended gateway for trust model analysis
    sh:property [
        sh:path report:recipientTrust ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "recipientTrust" ;
        sh:message "If present, report:recipientTrust must be a string."
    ] ;

    # ⚠️ OPTIONAL: trust source for purpose (jwt-trusted-issuer, app-registry, url-inferred, none)
    # Added in extended gateway for trust model analysis
    sh:property [
        sh:path report:purposeTrust ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "purposeTrust" ;
        sh:message "If present, report:purposeTrust must be a string."
    ] ;

    # ⚠️ OPTIONAL: trust source for legal basis (resource-data, jwt-trusted-issuer, none)
    # Added in extended gateway for trust model analysis
    sh:property [
        sh:path report:legalBasisTrust ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "legalBasisTrust" ;
        sh:message "If present, report:legalBasisTrust must be a string."
    ] ;

    # ⚠️ OPTIONAL: trust source for temporal (always server-clock)
    # Added in extended gateway for trust model analysis
    sh:property [
        sh:path report:temporalTrust ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:hasValue "server-clock" ;
        sh:name "temporalTrust" ;
        sh:message "If present, report:temporalTrust must be \"server-clock\" (gateway-controlled)."
    ] .


# ============================================================================
# 2. PERSONAL DATA HANDLING SHAPE
# ============================================================================
# Records DPV-compliant personal data handling context for each access.
# Emitted when accessed data is classified as sensitive (dpv:PersonalData).
# ============================================================================
ex:PersonalDataHandlingShape a sh:NodeShape ;
    sh:targetClass dpv:PersonalDataHandling ;
    sh:name "Personal Data Handling Shape" ;
    sh:description "Validates DPV-compliant personal data handling records." ;

    # Required: processing operation (dpv:Access, dpv:Create, dpv:Update, etc.)
    sh:property [
        sh:path dpv:hasProcessing ;
        sh:minCount 1 ;
        sh:name "hasProcessing" ;
        sh:message "PersonalDataHandling must specify dpv:hasProcessing." ;
        sh:nodeKind sh:IRI
    ] ;

    # Required: data subject (the pod owner)
    sh:property [
        sh:path dpv:hasDataSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "hasDataSubject" ;
        sh:message "PersonalDataHandling must reference the data subject via dpv:hasDataSubject." ;
        sh:or (
            [ sh:class foaf:Agent ]
            [ sh:nodeKind sh:IRI ]
        )
    ] .


# ============================================================================
# 3. ACCESSED DATA FIELD SHAPE
# ============================================================================
# Per-field record for each accessed RDF predicate, with DPV classification
# and sensitivity flag. Emitted for every field in the accessed resource.
# ============================================================================
ex:AccessedDataFieldShape a sh:NodeShape ;
    sh:targetClass report:AccessedDataField ;
    sh:name "Accessed Data Field Shape" ;
    sh:description "Validates per-field accessed data records with DPV classification." ;

    # Required: field IRI (the RDF predicate)
    sh:property [
        sh:path report:fieldIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "fieldIRI" ;
        sh:message "AccessedDataField must reference the field IRI via report:fieldIRI."
    ] ;

    # Required: human-readable field name
    sh:property [
        sh:path report:fieldName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "fieldName" ;
        sh:message "AccessedDataField must have a report:fieldName."
    ] ;

    # Required: field value (the actual data value)
    sh:property [
        sh:path report:fieldValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "fieldValue" ;
        sh:message "AccessedDataField must have a report:fieldValue."
    ] ;

    # Required: sensitivity flag (boolean)
    sh:property [
        sh:path report:isSensitive ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isSensitive" ;
        sh:message "AccessedDataField must have a boolean report:isSensitive flag."
    ] ;

    # ⚠️ OPTIONAL: DPV data category
    # Kept optional to accommodate legacy logs without DPV classification
    sh:property [
        sh:path report:dataCategory ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:name "dataCategory" ;
        sh:message "If present, report:dataCategory must be an IRI or string." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] ;

    # ⚠️ OPTIONAL: DPV personal data type
    # Kept optional to accommodate legacy logs without DPV classification
    sh:property [
        sh:path report:personalDataType ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:name "personalDataType" ;
        sh:message "If present, report:personalDataType must be an IRI or string." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] .


# ============================================================================
# 4. POLICY EVALUATION SHAPE
# ============================================================================
# Per-field policy-evaluation record. Emitted for every accessed field that
# is protected by an active policy.
# ============================================================================
ex:PolicyEvaluationShape a sh:NodeShape ;
    sh:targetClass report:PolicyEvaluation ;
    sh:name "Policy Evaluation Shape" ;
    sh:description "Validates a per-field ODRL policy-evaluation record." ;

    # Required: evaluated policy (alias IRI)
    sh:property [
        sh:path report:evaluatedPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "evaluatedPolicy" ;
        sh:message "PolicyEvaluation must reference the evaluated policy via report:evaluatedPolicy." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] ;

    # Required: evaluation result (ALLOWED or VIOLATION)
    sh:property [
        sh:path report:evaluationResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "ALLOWED" "VIOLATION" ) ;
        sh:name "evaluationResult" ;
        sh:message "PolicyEvaluation must have report:evaluationResult of \"ALLOWED\" or \"VIOLATION\"."
    ] ;

    # Required: evaluation reason (human-readable)
    sh:property [
        sh:path report:evaluationReason ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "evaluationReason" ;
        sh:message "PolicyEvaluation must have a report:evaluationReason."
    ] ;

    # Required: target asset IRI
    sh:property [
        sh:path report:targetAsset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "targetAsset" ;
        sh:message "PolicyEvaluation must reference the target asset via report:targetAsset." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] .


# ============================================================================
# 5. FIELD VIOLATION SHAPE (Count Violations)
# ============================================================================
# Per-field count-violation detail. Emitted only when observedCount > limit
# for a specific field + action combination.
# ============================================================================
ex:FieldViolationShape a sh:NodeShape ;
    sh:targetClass report:FieldViolation ;
    sh:name "Field Violation Shape" ;
    sh:description "Validates a per-field count-violation detail record." ;

    # Required: violated field IRI
    sh:property [
        sh:path report:violatedField ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "violatedField" ;
        sh:message "FieldViolation must reference the violated field IRI via report:violatedField."
    ] ;

    # Required: violated policy (alias IRI)
    sh:property [
        sh:path report:violatedPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "violatedPolicy" ;
        sh:message "FieldViolation must reference the violated policy via report:violatedPolicy." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] ;

    # Required: observed count (integer)
    sh:property [
        sh:path report:observedCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "observedCount" ;
        sh:message "FieldViolation must have an integer report:observedCount."
    ] ;

    # Required: allowed limit (integer)
    sh:property [
        sh:path report:allowedLimit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:name "allowedLimit" ;
        sh:message "FieldViolation must have an integer report:allowedLimit."
    ] ;

    # ⚠️ OPTIONAL: ODRL action type (ex:read, ex:create, ex:update, ex:delete)
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:actionType ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "actionType" ;
        sh:message "If present, report:actionType must be a string."
    ] .


# ============================================================================
# 6. CONSTRAINT VIOLATION SHAPE (Non-Count Violations)
# ============================================================================
# Per-constraint violation detail for purpose, legal-basis, temporal, and
# recipient violations (Tier-2 accountability evidence).
# ============================================================================
ex:ConstraintViolationShape a sh:NodeShape ;
    sh:targetClass report:ConstraintViolation ;
    sh:name "Constraint Violation Shape" ;
    sh:description "Validates a constraint-violation detail record (purpose, legal-basis, temporal, recipient)." ;

    # Required: violation type (e.g., PurposeViolation, LegalBasisViolation, etc.)
    sh:property [
        sh:path report:violationType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "violationType" ;
        sh:message "ConstraintViolation must have a report:violationType."
    ] ;

    # Required: violated left operand (odrl:purpose, dpv:hasLegalBasis, odrl:dateTime, odrl:recipient)
    sh:property [
        sh:path report:violatedLeftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "violatedLeftOperand" ;
        sh:message "ConstraintViolation must have a report:violatedLeftOperand."
    ] ;

    # Required: violated operator (odrl:eq, odrl:isAnyOf, etc.)
    sh:property [
        sh:path report:violatedOperator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "violatedOperator" ;
        sh:message "ConstraintViolation must have a report:violatedOperator."
    ] ;

    # Required: required value (the expected value from the policy)
    sh:property [
        sh:path report:requiredValue ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "requiredValue" ;
        sh:message "ConstraintViolation must have a report:requiredValue."
    ] ;

    # Required: declared value (the actual value observed at runtime)
    sh:property [
        sh:path report:declaredValue ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "declaredValue" ;
        sh:message "ConstraintViolation must have a report:declaredValue."
    ] ;

    # ⚠️ OPTIONAL: trust source for the claim
    # Added in extended gateway; legacy logs may omit this field
    sh:property [
        sh:path report:claimTrustSource ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "claimTrustSource" ;
        sh:message "If present, report:claimTrustSource must be a string."
    ] .


# ============================================================================
# 7. POLICY VIOLATION SHAPE (Access-Level)
# ============================================================================
# Access-level policy-violation record. Aggregates all violations for a
# single access attempt.
# ============================================================================
ex:PolicyViolationShape a sh:NodeShape ;
    sh:targetClass report:PolicyViolation ;
    sh:name "Policy Violation Shape" ;
    sh:description "Validates an access-level policy-violation record." ;

    # Required: violation type (main violation type)
    sh:property [
        sh:path report:violationType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "violationType" ;
        sh:message "PolicyViolation must have a report:violationType."
    ] ;

    # Required: violation timestamp
    sh:property [
        sh:path report:violationTimestamp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:name "violationTimestamp" ;
        sh:message "PolicyViolation must have a report:violationTimestamp (xsd:dateTime)."
    ] ;

    # Required: violated policy (one or more policy aliases)
    sh:property [
        sh:path report:violatedPolicy ;
        sh:minCount 1 ;
        sh:name "violatedPolicy" ;
        sh:message "PolicyViolation must reference at least one violated policy via report:violatedPolicy." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] ;

    # Optional: has field violation (for count violations)
    sh:property [
        sh:path report:hasFieldViolation ;
        sh:nodeKind sh:IRI ;
        sh:class report:FieldViolation ;
        sh:name "hasFieldViolation" ;
        sh:message "report:hasFieldViolation must point to a report:FieldViolation."
    ] ;

    # Optional: has constraint violation (for purpose, legal-basis, temporal, recipient)
    sh:property [
        sh:path report:hasConstraintViolation ;
        sh:nodeKind sh:IRI ;
        sh:class report:ConstraintViolation ;
        sh:name "hasConstraintViolation" ;
        sh:message "report:hasConstraintViolation must point to a report:ConstraintViolation."
    ] .


# ============================================================================
# 8. DUTY OBLIGATION SHAPE
# ============================================================================
# Records duty obligations (e.g., odrl:inform) for each access that carries
# a duty. Emitted regardless of whether a violation occurred (Tier-2
# accountability).
# ============================================================================
ex:DutyObligationShape a sh:NodeShape ;
    sh:targetClass report:DutyObligation ;
    sh:name "Duty Obligation Shape" ;
    sh:description "Validates duty obligation records (e.g., notification duties)." ;

    # Required: duty action (e.g., odrl:inform)
    sh:property [
        sh:path report:dutyAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "dutyAction" ;
        sh:message "DutyObligation must have a report:dutyAction."
    ] ;

    # Required: duty target (who should be notified/informed)
    sh:property [
        sh:path report:dutyTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "dutyTarget" ;
        sh:message "DutyObligation must have a report:dutyTarget." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] ;

    # Required: duty fulfilled status (boolean)
    sh:property [
        sh:path report:dutyFulfilled ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "dutyFulfilled" ;
        sh:message "DutyObligation must have a boolean report:dutyFulfilled status."
    ] .


# ============================================================================
# 9. POLICY ALIAS MAPPING SHAPE (O-Prime Specific)
# ============================================================================
# Maps policy aliases (used in audit logs) to actual policy resources and
# their UUIDs. Ensures audit log references can be resolved to the original
# policy definition.
# ============================================================================
ex:PolicyAliasShape a sh:NodeShape ;
    sh:targetClass report:PolicyAlias ;
    sh:name "Policy Alias Mapping Shape" ;
    sh:description "Validates O-Prime policy alias mappings used in audit logs." ;

    # Required: maps to policy (the actual policy resource IRI)
    sh:property [
        sh:path report:mapsToPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "mapsToPolicy" ;
        sh:message "Policy alias must map to exactly one policy resource IRI."
    ] ;

    # Required: maps to UUID (the policy's urn:uuid identifier)
    sh:property [
        sh:path report:mapsToUUID ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "mapsToUUID" ;
        sh:message "Policy alias must map to exactly one UUID." ;
        sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$|^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" ;
        sh:message "UUID must be in format urn:uuid:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx or just the UUID string."
    ] .