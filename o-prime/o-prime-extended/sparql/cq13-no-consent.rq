# CQ13: Which accesses to sensitive data lacked explicit consent?
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX report: <https://w3id.org/force/compliance-report#>

SELECT DISTINCT ?agent ?timestamp ?resource ?declaredBasis ?trustSource
WHERE {
  ?activity a prov:Activity ;
            prov:wasAssociatedWith ?agent ;
            prov:startedAtTime ?timestamp ;
            prov:used ?resource ;
            report:hasViolationBundle ?vb .
  ?vb prov:hadMember ?v .
  ?v report:hasConstraintViolation ?cv .
  ?cv report:violatedLeftOperand "dpv:hasLegalBasis" ;
      report:requiredValue "dpv:ExplicitConsent" ;
      report:declaredValue ?declaredBasis .
  FILTER (?declaredBasis != "dpv:ExplicitConsent")
  OPTIONAL { ?cv report:claimTrustSource ?trustSource }
}
ORDER BY DESC(?timestamp)