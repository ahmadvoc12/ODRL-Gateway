# CQ5: Which accesses fell outside the allowed time window?
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX report: <https://w3id.org/force/compliance-report#>

SELECT ?activity ?agent ?timestamp ?required ?declared
WHERE {
  ?activity a prov:Activity ;
            prov:wasAssociatedWith ?agent ;
            prov:startedAtTime ?timestamp ;
            report:hasViolationBundle ?vb .
  ?vb prov:hadMember ?v .
  ?v report:hasConstraintViolation ?cv .
  ?cv report:violatedLeftOperand "odrl:dateTime" ;
      report:requiredValue ?required ;
      report:declaredValue ?declared .
}
ORDER BY DESC(?timestamp)
